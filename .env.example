# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Baza — ko'rsatilmasa SQLite ishlatiladi
# DATABASE_URL=postgresql://migration:parol@localhost:5432/migration

# Frontend manzillari
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Cheklovlar
THROTTLE_SIGN_IN=10/min
THROTTLE_EXPORT=20/min

LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=True
# Reverse-proxy HTTPS ni o'zi hal qilsa: SECURE_SSL_REDIRECT=False
